#!/usr/bin/env bash
# aircam: one command for the camera airspeed sensor.
#
#   On the Pi, once:   cd ~/sensors/cw2 && ./aircam install       (then `aircam` works from anywhere)
#   Physical rig:      aircam real detect | view | run | check | pluck | cal | set …   (and real start | stop | logs)
#   Simulation:        aircam sim detect | view | run LAPTOP | check | cal | set …
#   On the laptop:     ./aircam install (makes .venv), ./aircam screen, ./aircam fit <run>_aligned.csv
#
# Everything except install, update and real start/stop/status/logs is `python -m aircam …`: aircam --help.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PI_VENV="$HOME/comp0219"            # the week 6 environment: apt packages via --system-site-packages

python_bin() {
  if [[ -x "$PI_VENV/bin/python" && "$(uname)" == Linux ]]; then echo "$PI_VENV/bin/python"
  elif [[ -x "$HERE/.venv/bin/python" ]]; then echo "$HERE/.venv/bin/python"
  else echo python3; fi
}

install_pi() {
  echo "== apt packages (Picamera2, NumPy, pyserial, OpenCV for the preview window)"
  sudo apt-get update -qq
  sudo apt-get install -y python3-picamera2 python3-numpy python3-serial python3-opencv
  if [[ ! -x "$PI_VENV/bin/python" ]]; then
    echo "== $PI_VENV (venv over the apt packages; never pip-install numpy or opencv into it)"
    python3 -m venv "$PI_VENV" --system-site-packages
  fi
  echo "== serial port on GPIO14/15 (header pin 8 TXD to the adapter's RX, pin 6 GND to its GND)"
  local boot=/boot/firmware/config.txt
  [[ -f $boot ]] || boot=/boot/config.txt
  if ! grep -q '^dtparam=uart0=on' "$boot"; then
    echo 'dtparam=uart0=on' | sudo tee -a "$boot" >/dev/null
    echo "   added dtparam=uart0=on to $boot: reboot once for /dev/ttyAMA0 to appear"
  fi
  echo "== the aircam command (in /usr/local/bin, which every terminal searches) and the aircam service"
  sudo ln -sf "$HERE/aircam" /usr/local/bin/aircam
  [[ -L $HOME/.local/bin/aircam ]] && rm -f "$HOME/.local/bin/aircam"    # where an older install put it
  sed -e "s|@USER@|$USER|g" -e "s|@HOME@|$HOME|g" -e "s|@HERE@|$HERE|g" -e "s|@PY@|$PI_VENV/bin/python|g" \
    "$HERE/pi/deploy/aircam.service" | sudo tee /etc/systemd/system/aircam.service >/dev/null
  sudo systemctl daemon-reload
  "$PI_VENV/bin/python" -c "import picamera2, numpy, serial, cv2; print('picamera2 ok | numpy', numpy.__version__, '| opencv', cv2.__version__)"
  echo "done. Next: aircam real detect  (fan off), or aircam sim detect for the screen simulation"
}

install_laptop() {
  [[ -x "$HERE/.venv/bin/python" ]] || python3 -m venv "$HERE/.venv"
  "$HERE/.venv/bin/pip" install -q -r "$HERE/pi/requirements-laptop.txt"
  echo "done: ./aircam screen (the simulator), ./aircam fit <run>_aligned.csv, ./aircam offline"
}

case "${1:-}" in
  install)  if [[ "$(uname)" == Linux ]]; then install_pi; else install_laptop; fi ;;
  real)     case "${2:-}" in      # the physical rig as a background service: closing the shell does not stop it
              start)  exec sudo systemctl start aircam ;;
              stop)   exec sudo systemctl stop aircam ;;
              status) exec systemctl status aircam --no-pager ;;
              logs)   exec journalctl -u aircam -f -n 20 ;;
            esac
            export PYTHONPATH="$HERE/pi${PYTHONPATH:+:$PYTHONPATH}"
            exec "$(python_bin)" -m aircam "$@" ;;
  update)   git -C "$HERE" pull --ff-only ;;
  *)        # stay in the caller's directory, so relative paths (fit's CSV) still resolve
            export PYTHONPATH="$HERE/pi${PYTHONPATH:+:$PYTHONPATH}"
            [[ $# -gt 0 ]] || set -- --help
            exec "$(python_bin)" -m aircam "$@" ;;
esac
